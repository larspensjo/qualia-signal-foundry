{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build workspace",
      "type": "shell",
      "command": "cargo build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Run app",
      "type": "shell",
      "command": "cargo run --package qsf_app",
      "group": "none",
      "problemMatcher": [
        "$rustc"
      ],
      "dependsOn": "Build workspace"
    },
    {
      "label": "Test workspace",
      "type": "shell",
      "command": "cargo test",
      "group": "test",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Clippy",
      "type": "shell",
      "command": "cargo clippy --all-targets -- -D warnings",
      "group": "build",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Format",
      "type": "shell",
      "command": "cargo fmt",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Clean workspace",
      "type": "shell",
      "command": "cargo clean",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "UI build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/crates/qsf_browser_server/ui"
      },
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "UI dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/crates/qsf_browser_server/ui"
      },
      "isBackground": true,
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "UI test",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/crates/qsf_browser_server/ui"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "UI check",
      "type": "shell",
      "command": "npm run check",
      "options": {
        "cwd": "${workspaceFolder}/crates/qsf_browser_server/ui"
      },
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "UI format",
      "type": "shell",
      "command": "npm run fmt",
      "options": {
        "cwd": "${workspaceFolder}/crates/qsf_browser_server/ui"
      },
      "group": "none",
      "problemMatcher": []
    }
  ]
}
