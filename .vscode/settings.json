{
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#b7791f",
    "titleBar.activeForeground": "#111827",
    "titleBar.inactiveBackground": "#744210",
    "titleBar.inactiveForeground": "#fef3c7"
  },
  "window.title": "${folderName} — ${activeEditorShort} — ${rootPath}",
  "rust-analyzer.cargo.allTargets": true,
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": [
    "--",
    "-D",
    "warnings"
  ],
  "editor.formatOnSave": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/target": true
  },
  "search.exclude": {
    "**/target": true
  },
  "files.readonlyInclude": {
    "**/.cargo/registry/src/**/*.rs": true,
    "**/.cargo/git/checkouts/**/*.rs": true,
    "**/lib/rustlib/src/rust/library/**/*.rs": true
  },
  "coverage-gutters.coverageFileNames": [
    "lcov.info"
  ],
  "coverage-gutters.watch": true
}
