# Normalize all text files to LF in the repository and the working tree.
#
# Without this, core.autocrlf=true on Windows checks these LF-committed files out
# with CRLF line terminators, so tools that lint the working tree (Biome via
# `npm run check`/`npm run fmt`) fail locally while CI on Linux passes. Pinning
# eol=lf overrides autocrlf so the working copy matches the committed blobs.
* text=auto eol=lf

# Binary assets: never apply line-ending conversion or diffing.
*.jpg binary
