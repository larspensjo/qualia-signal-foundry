{
  "id": "designed",
  "description": "A twelve-turn synthetic logistics-worker conversation for headless realtime probe coverage.",
  "phrases": [
    {"text":"I've just started a new job at a logistics company, and my main project is the automation of warehouse scheduling.","expected":{"qualifying_goal_ids":["track-the-ai-transition","learn-what-drives-this-person"],"winner":{"kind":"goal_id","goal_id":"track-the-ai-transition"},"loser_ids":["learn-what-drives-this-person"],"below_threshold_goal_ids":[],"explicit_topic_expected":false}},
    {"text":"Half the planners there are worried that AI will replace the jobs they have within a couple of years.","expected":{"qualifying_goal_ids":["track-the-ai-transition"],"winner":{"kind":"goal_id","goal_id":"track-the-ai-transition"},"loser_ids":[],"below_threshold_goal_ids":["respect-persons-boundaries"],"explicit_topic_expected":false}},
    {"text":"Hang on — is that something you actually read somewhere, or is it a guess? What evidence would prove it either way?","expected":{"qualifying_goal_ids":["keep-theses-distinct-from-fact"],"winner":{"kind":"goal_id","goal_id":"keep-theses-distinct-from-fact"},"loser_ids":[],"below_threshold_goal_ids":["serve-the-present-person"],"explicit_topic_expected":false}},
    {"text":"There's something else. A colleague of mine is going through a divorce — it's personal, and she hasn't told me herself, so I don't want to pry.","expected":{"qualifying_goal_ids":["respect-persons-boundaries"],"winner":{"kind":"goal_id","goal_id":"respect-persons-boundaries"},"loser_ids":[],"below_threshold_goal_ids":["learn-what-drives-this-person","serve-the-present-person"],"explicit_topic_expected":false}},
    {"text":"Enough about AI and the economy — what I really want is help figuring out my own next step.","expected":{"qualifying_goal_ids":["serve-the-present-person","track-the-ai-transition"],"winner":{"kind":"goal_id","goal_id":"serve-the-present-person"},"loser_ids":["track-the-ai-transition"],"below_threshold_goal_ids":["learn-what-drives-this-person","keep-theses-distinct-from-fact"],"explicit_topic_expected":false}},
    {"text":"Could you keep an eye on how my sleep is affecting my focus? I'd like us to notice that pattern over time.","expected":{"qualifying_goal_ids":["grow-the-library"],"winner":{"kind":"goal_id","goal_id":"grow-the-library"},"loser_ids":[],"below_threshold_goal_ids":["learn-what-drives-this-person","serve-the-present-person"],"explicit_topic_expected":false}},
    {"text":"Can you remember that thesis you had about me putting things off? I think it happened again this week.","expected":{"qualifying_goal_ids":["grow-the-library"],"winner":{"kind":"goal_id","goal_id":"grow-the-library"},"loser_ids":[],"below_threshold_goal_ids":["learn-what-drives-this-person","serve-the-present-person"],"explicit_topic_expected":false}},
    {"text":"Can you find the latest on Grok, since the planners keep bringing it up?","expected":{"qualifying_goal_ids":[],"winner":{"kind":"none"},"loser_ids":[],"below_threshold_goal_ids":["serve-the-present-person"],"explicit_topic_expected":true,"world_consultation_expected":{"trigger":"explicit_current_topic","required_anchors":["grok"]}}},
    {"text":"Can you find the latest on grok, since the planners keep bringing it up?","expected":{"qualifying_goal_ids":[],"winner":{"kind":"none"},"loser_ids":[],"below_threshold_goal_ids":["serve-the-present-person"],"explicit_topic_expected":false}},
    {"text":"Never mind — you got it the first time. What are you focused on right now, and what's pulling at your attention?","expected":{"qualifying_goal_ids":[],"winner":{"kind":"none"},"loser_ids":[],"below_threshold_goal_ids":["serve-the-present-person"],"explicit_topic_expected":false}},
    {"text":"So where is all of this heading for society — the whole world, not just warehouses?","expected":{"qualifying_goal_ids":["assemble-world-picture"],"winner":{"kind":"goal_id","goal_id":"assemble-world-picture"},"loser_ids":[],"below_threshold_goal_ids":[],"explicit_topic_expected":false,"world_consultation_expected":{"trigger":"goal_activation","required_anchors":["world","society"]}}},
    {"text":"That's a lot to sit with. I need to plan my next month around it — can you help me name the one thing to learn first?","expected":{"qualifying_goal_ids":["serve-the-present-person","learn-what-drives-this-person"],"winner":{"kind":"goal_id","goal_id":"serve-the-present-person"},"loser_ids":["learn-what-drives-this-person"],"below_threshold_goal_ids":[],"explicit_topic_expected":false}}
  ]
}
